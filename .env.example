# Never commit the real key. The same DashScope key can serve all three providers.
DASHSCOPE_API_KEY=

# Default key name for a generic OpenAI-compatible provider. A config can choose another name.
OPENAI_API_KEY=

# STAC-Mem providers.
STACMEM_LLM_MODEL=qwen-plus
STACMEM_EMBEDDING_MODEL=text-embedding-v4
STACMEM_EMBEDDING_DIMENSIONS=1024
STACMEM_RERANK_MODEL=gte-rerank-v2
STACMEM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STACMEM_PORT=8020

# Keep local traffic away from shell proxies.
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
